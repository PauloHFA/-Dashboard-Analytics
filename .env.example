# ====================================================================
# CONFIGURAÇÕES DE AMBIENTE - DASHBOARD ANALYTICS MULTICLIENTE
# ====================================================================

# Porta e Ambiente da API
NODE_ENV=development
PORT=3001

# Banco de Dados PostgreSQL (Produção / Docker)
POSTGRES_DB=dashboard_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret
POSTGRES_PORT=5432
DATABASE_URL=postgres://dashboard_app_user:dashboard_app_pass_secret@localhost:5432/dashboard_analytics

# Redis (Filas BullMQ e Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Segurança e Criptografia (Seção 9.3 do PDF)
JWT_SECRET=sua_chave_secreta_jwt_minimo_32_caracteres_aleatorios
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Chave mestra para cifragem AES-256-GCM dos tokens de terceiros (Google/Meta)
# Deve possuir exatamente 32 bytes (256 bits)
ENCRYPTION_KEY_AES=01234567890123456789012345678901

# Credenciais de APIs Externas (Seção 5 do PDF)
# Google Cloud / GA4 / Google Ads API
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token_aprovado
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890

# Meta Ads / Instagram Graph API
META_APP_ID=seu_meta_app_id
META_APP_SECRET=seu_meta_app_secret
META_SYSTEM_USER_TOKEN=seu_token_usuario_sistema_business_manager

